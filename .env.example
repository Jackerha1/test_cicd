# ===== AI CI/CD Configuration =====

# URL of the claude-cli-api FastAPI server
# Start it with:  cd claude-cli-api && uvicorn main:app --port 8765
CLAUDE_CLI_API_URL=http://localhost:8200

# v3: OpenAI provider (talks to openai-api/, port 8300 by default).
OPENAI_API_URL=http://localhost:8300

# v3: Force a single provider for ALL agents (overrides per-agent routing).
# Useful for A/B comparisons: AICICD_FORCE_PROVIDER=openai ai-cicd run ...
# AICICD_FORCE_PROVIDER=
# AICICD_FORCE_MODEL=

# Per-call timeout (seconds) for Claude CLI invocations
CLAUDE_CALL_TIMEOUT=180

# Workspace where pipeline runs do their work (cloned repos, patches, artifacts)
WORKSPACE_DIR=./artifacts

# SQLite path for the immutable audit log
AUDIT_DB_PATH=./logs/audit.db

# Sandbox mode: "subprocess" runs in current shell with restrictions,
# "docker" runs each agent step in a container (requires Docker).
SANDBOX_MODE=subprocess

# Max retries before pipeline aborts and asks for human help
MAX_AGENT_RETRIES=2

# When true, risky actions auto-approve (USE ONLY FOR LOCAL DEMO)
# In real deployment this MUST be false.
AUTO_APPROVE=false
