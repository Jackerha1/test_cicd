# Required for live mode. If empty, the server falls back to MOCK mode that
# echoes a fixed JSON envelope — useful for keyless dev / CI smoke tests.
OPENAI_API_KEY=

# Default model when the request doesn't specify one.
OPENAI_DEFAULT_MODEL=gpt-5

# HTTP port (mirror claude-cli-api default scheme).
PORT=8300

# When true, server returns a deterministic fake response instead of calling
# OpenAI. Useful for CI / offline dev.
OPENAI_MOCK=false
