{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeReview",
  "type": "object",
  "required": ["summary", "issues", "recommendation"],
  "properties": {
    "summary": {"type": "string"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "comment"],
        "properties": {
          "severity": {"enum": ["nit", "minor", "major", "blocker"]},
          "file":     {"type": "string"},
          "line":     {"type": "integer"},
          "comment":  {"type": "string"}
        }
      }
    },
    "recommendation": {"enum": ["approve", "request_changes", "block"]},
    "scope_creep_detected": {"type": "boolean", "default": false}
  }
}
