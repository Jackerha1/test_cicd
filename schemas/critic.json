{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Critic",
  "type": "object",
  "required": ["target_agent", "score_overall", "subscores", "reasoning"],
  "properties": {
    "target_agent": {"type": "string"},
    "score_overall": {"type": "number", "minimum": -1, "maximum": 10},
    "subscores": {
      "type": "object",
      "properties": {
        "correctness":      {"type": "number", "minimum": 0, "maximum": 10},
        "scope_discipline": {"type": "number", "minimum": 0, "maximum": 10},
        "evidence_use":     {"type": "number", "minimum": 0, "maximum": 10},
        "output_quality":   {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {"enum": ["hallucination", "scope_creep", "vague_reasoning",
                          "overconfidence", "policy_violation", "format_error", "none"]}
    },
    "reasoning": {"type": "string"}
  }
}
