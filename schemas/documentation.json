{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation",
  "type": "object",
  "required": ["files", "summary"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path":    {"type": "string"},
          "content": {"type": "string", "description": "Full file content after edit."}
        }
      }
    },
    "summary": {"type": "string"},
    "changelog_entry": {"type": "string"}
  }
}
